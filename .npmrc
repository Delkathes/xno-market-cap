# Set the maximum number of child processes that pnpm can run concurrently.
child-concurrency = 12

# Set the maximum number of sockets to use for HTTP requests.
maxsockets = 100

# Set the maximum number of concurrent network requests.
network-concurrency = 36

# Prefer using the frozen lockfile if available.
prefer-frozen-lockfile = true

# Disable automatic installation of peer dependencies.
auto-install-peers = false

# Enforce strict peer dependency resolution.
strict-peer-dependencies = true

# Enable strict enforcement of engine requirements.
engine-strict = true

# Enable offline cache.
prefer-offline = true